PORT=3850
JWT_SECRET=change-me-in-production

# Défaut chat (Groq recommandé)
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_REASON=openai/gpt-oss-120b

# Autres fournisseurs (optionnels)
OPENAI_OWN_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Images — gratuit = Pollinations classic (~768²). Excellence = clé.
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=dall-e-3
IMAGE_QUALITY=hd
# enter.pollinations.ai → Flux schnell / modèles gen (nettement mieux que classic)
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=flux
IMAGE_MAX_SIDE=1024

# Recherche
TAVILY_API_KEY=

# Vidéo — AUCUN chemin gratuit excellent (2026). Branche une clé :
#   VIDEO_PROVIDER=fal|pollinations|runway|luma|openai|generic
#   FAL_KEY=...                    (~0,05–0,10 $/clip Wan turbo)
#   POLLINATIONS_API_KEY=...       (+ Pollen; Wan 2.2 fast ~0,05 $/clip)
#   RUNWAYML_API_SECRET=...        (~0,25–0,50 $/clip 5s)
#   LUMA_API_KEY=...
#   OPENAI_OWN_API_KEY=...         (Sora)
# Ou générique : VIDEO_API_KEY + VIDEO_API_URL (POST {prompt} → {url})
VIDEO_PROVIDER=
FAL_KEY=
RUNWAYML_API_SECRET=
LUMA_API_KEY=
VIDEO_API_KEY=
VIDEO_API_URL=
VIDEO_MODEL=
VIDEO_DURATION=5
VIDEO_RESOLUTION=480p

# Billing
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

FREE_DAILY_IMAGES=3
FREE_DAILY_VIDEOS=1
ENSEMBLE_DAILY_CAP=10

# Pro soft weekly ceilings (calendar week Mon→Sun, America/Toronto). Reset lundi.
# Generous vs Free daily quotas — normal use rarely hits these.
PRO_WEEKLY_MESSAGES=2500
PRO_WEEKLY_IMAGES=150
PRO_WEEKLY_VIDEOS=30
PRO_WEEKLY_ENSEMBLE=40

CHAT_MAX_TOKENS=1200
VISION_MAX_TOKENS=600
