PORT=3850
JWT_SECRET=change-me-in-production

# Défaut chat (Groq recommandé)
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_REASON=openai/gpt-oss-120b

# Autres fournisseurs (optionnels)
OPENAI_OWN_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Images payantes (sinon Pollinations gratuit)
# IMAGE_API_KEY + IMAGE_BASE_URL → DALL·E / OpenAI-compatible (meilleure qualité)
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=dall-e-3
IMAGE_QUALITY=hd
# Optionnel: clé enter.pollinations.ai pour Flux sans logo / moins de rate-limit
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=flux
IMAGE_MAX_SIDE=1024

# Recherche / vidéo
TAVILY_API_KEY=
VIDEO_API_KEY=
VIDEO_API_URL=
VIDEO_PROVIDER=stub

# Billing
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

FREE_DAILY_IMAGES=3
FREE_DAILY_VIDEOS=1
ENSEMBLE_DAILY_CAP=10
CHAT_MAX_TOKENS=1200
VISION_MAX_TOKENS=600
